<!-- Certificate Modal -->
<CertificateModal Certificate="selectedCert" OnClose="CloseCert" />

@code {
    private List<ProjectItem> projects = new();
    private List<ProjectItem> filteredProjects = new();
    private List<CertificateItem> certificates = new();
    private CertificateItem? selectedCert;
    private string filter = "all";

    protected override async Task OnInitializedAsync()
    {
        projects = await Api.GetProjectsAsync();
        filteredProjects = projects;
        certificates = await Api.GetCertificatesAsync();
    }

    private void SetFilter(string selected)
    {
        filter = selected;
        if (selected == "all")
        {
            filteredProjects = projects;
        }
        else if (selected == "RAG")
        {
            filteredProjects = projects.Where(p => p.Category.Contains("RAG", StringComparison.OrdinalIgnoreCase) || p.TechStack.Any(t => t.Equals("RAG", StringComparison.OrdinalIgnoreCase))).ToList();
        }
        else if (selected == "Multi-Agent")
        {
            filteredProjects = projects.Where(p => p.Category.Contains("Agent", StringComparison.OrdinalIgnoreCase) || p.TechStack.Any(t => t.Contains("Agent", StringComparison.OrdinalIgnoreCase))).ToList();
        }
    }

    private void OpenCert(CertificateItem cert) => selectedCert = cert;
    private void CloseCert() => selectedCert = null;

    private async Task ScrollToSection(string elementId)
    {
        await JS.InvokeVoidAsync("portfolio.scrollToElement", elementId);
    }
}
