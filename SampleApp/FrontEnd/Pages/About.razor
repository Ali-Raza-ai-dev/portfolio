@page "/about"
@using FrontEnd.Data
@inject PortfolioApiClient Api

<PageTitle>About Ali Raza — Agentic AI &amp; Automation Developer</PageTitle>

<div style="background:var(--cream); padding-top:140px; padding-bottom:120px;">
    <div class="wrap">
        <!-- Breadcrumb -->
        <div style="display:flex; align-items:center; gap:8px; font-family:var(--mono); font-size:12px; color:var(--muted); margin-bottom:32px;">
            <a href="" style="color:var(--navy);">HOME</a>
            <span>/</span>
            <span style="color:var(--orange); font-weight:700;">ABOUT ALI</span>
        </div>

        <!-- Header -->
        <div style="max-width:960px; margin-bottom:64px;">
            <span class="eyebrow">The Engineer Behind The Systems</span>
            <h1 class="mega" style="margin-top:20px; font-size:clamp(40px, 5.4vw, 84px);">
                Engineering grounded intelligence, <span class="it"><span class="ul">not AI hype.</span></span>
            </h1>
            <p style="font-size:clamp(18px, 1.6vw, 24px); line-height:1.45; color:var(--ink-2); margin-top:28px;">
                I help businesses work smarter through intelligent, AI-powered solutions. I specialize in designing and deploying RAG systems, LLM-based agents, and automated workflows that eliminate manual bottlenecks, reduce operational costs, and accelerate decision-making.
            </p>
        </div>

        <!-- Bio & Philosophy Grid -->
        <div style="display:grid; grid-template-columns:1.2fr 1fr; gap:64px; align-items:start; margin-bottom:96px;">
            <div style="display:flex; flex-direction:column; gap:20px; font-size:17px; line-height:1.75; color:var(--ink-2);">
                <p>
                    Backed by a strong foundation in <strong style="color:var(--navy);">Python</strong>, <strong style="color:var(--navy);">FastAPI</strong>, and <strong style="color:var(--navy);">.NET Core</strong>, I build reliable, scalable systems tailored to unique business needs — from multi-tenant SaaS chatbot platforms to multi-agent booking assistants.
                </p>
                <p>
                    Most companies rushing into generative AI fall into two traps: spending months building brittle wrappers that hallucinate in production, or giving their employees general chatbot licenses that end up only being used to reword emails.
                </p>
                <p>
                    My approach is strictly engineered around <strong style="color:var(--navy);">deterministic accuracy</strong>: your proprietary data remains safe, your vectors are tenant-isolated, responses cite exact document pages, and stateful LangGraph workflows handle complex multi-step tasks without derailing.
                </p>

                <div style="margin-top:24px; display:flex; gap:16px; flex-wrap:wrap;">
                    <a href="#contact" class="pill pill-navy">
                        Work With Ali <span class="ar">→</span>
                    </a>
                    <a href="https://github.com/167AliRaza" target="_blank" rel="noopener" class="pill pill-line">
                        View GitHub Codebase
                    </a>
                </div>
            </div>

            <!-- Profile Card -->
            <div>
                <div class="card c1" style="min-height:auto; padding:36px;">
                    <div style="width:100%; aspect-ratio:1; border-radius:18px; overflow:hidden; margin-bottom:24px; background:var(--navy-2);">
                        <img src="images/profile/ali.webp" alt="Ali Raza" style="width:100%; height:100%; object-fit:cover; object-position:center 20%;" />
                    </div>
                    <div>
                        <div class="k" style="color:var(--powder); margin-bottom:6px;">Agentic AI &amp; Automation Developer</div>
                        <h4 style="font-size:24px; color:var(--cream); margin-bottom:8px;">Ali Raza</h4>
                        <p style="font-size:14px; opacity:0.85; line-height:1.6;">
                            Based in Pakistan &bull; Building production AI pipelines for global companies.
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Career Timeline (Cogent Labs Method Style) -->
        <div style="margin-bottom:96px;">
            <span class="eyebrow">Career Experience</span>
            <h2 style="font-size:clamp(36px, 4.4vw, 68px); line-height:1; letter-spacing:-.035em; margin-top:16px; margin-bottom:48px;">
                Where I've Delivered Results
            </h2>

            <div style="display:grid; grid-template-columns:1fr 1fr; gap:28px;">
                @foreach (var exp in experience)
                {
                    <div class="card c-orange" style="min-height:auto;">
                        <div>
                            <div class="k">@exp.Period &bull; @exp.Location</div>
                            <h4 style="color:var(--navy);">@exp.Role <span style="font-family:var(--serif); font-style:italic; font-weight:400; color:var(--orange);">@@ @exp.Company</span></h4>
                            <ul style="list-style:none; display:flex; flex-direction:column; gap:10px; margin-top:16px; font-size:15px; line-height:1.6;">
                                @foreach (var r in exp.Responsibilities)
                                {
                                    <li style="display:flex; align-items:flex-start; gap:10px;">
                                        <span style="color:var(--navy); font-weight:700;">—</span>
                                        <span>@r</span>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Education Card -->
        <div style="margin-bottom:64px;">
            <span class="eyebrow">Academic Foundation</span>
            <div class="card c2" style="margin-top:24px; min-height:auto;">
                <div>
                    <div class="k">@education?.Period &bull; @education?.Location</div>
                    <h4 style="color:var(--navy);">@education?.Degree</h4>
                    <p style="font-size:17px; font-weight:600; color:var(--navy); opacity:0.9;">
                        @education?.Institution
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<ExperienceItem> experience = new();
    private EducationItem? education;

    protected override async Task OnInitializedAsync()
    {
        var expData = await Api.GetExperienceAsync();
        experience = expData.Experience;
        education = expData.Education;
    }
}
