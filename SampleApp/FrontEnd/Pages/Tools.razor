@page "/tools"

<PageTitle>Developer Tools — Free Browser Utilities — Ali Raza</PageTitle>

<div style="background:var(--cream); padding-top:140px; padding-bottom:120px;">
    <div class="wrap">
        <!-- Breadcrumb -->
        <div style="display:flex; align-items:center; gap:8px; font-family:var(--mono); font-size:12px; color:var(--muted); margin-bottom:32px;">
            <a href="" style="color:var(--navy);">HOME</a>
            <span>/</span>
            <span style="color:var(--orange); font-weight:700;">TOOLS HUB</span>
        </div>

        <!-- Header -->
        <div style="max-width:960px; margin-bottom:64px;">
            <span class="eyebrow">Zero Server Uploads</span>
            <h1 class="mega" style="margin-top:20px; font-size:clamp(38px, 5.2vw, 80px);">
                Developer Utilities That <span class="it"><span class="ul">Just Work.</span></span>
            </h1>
            <p style="font-size:clamp(18px, 1.6vw, 24px); line-height:1.45; color:var(--ink-2); margin-top:24px;">
                Free, browser-based utilities with zero sign-up and zero uploads to external servers. High-performance client-side execution powered by modern HTML5 web standards.
            </p>
        </div>

        <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(380px, 1fr)); gap:32px;">
            <!-- Tool 1 -->
            <div class="card c1">
                <div>
                    <span class="k">Web Audio &amp; HTML5 Video</span>
                    <h4>Video Speed &amp; Pitch Controller</h4>
                    <p>
                        Speed up or slow down videos instantly with pitch correction &amp; frame-by-frame stepping. Runs entirely inside your browser — zero latency, zero file upload to remote servers.
                    </p>
                    <div style="display:flex; flex-wrap:wrap; gap:8px; margin-top:24px;">
                        <span style="font-family:var(--mono); font-size:12px; border:1px solid currentColor; padding:3px 10px; border-radius:6px; opacity:0.8;">0.25x – 4.0x</span>
                        <span style="font-family:var(--mono); font-size:12px; border:1px solid currentColor; padding:3px 10px; border-radius:6px; opacity:0.8;">Pitch Normalization</span>
                        <span style="font-family:var(--mono); font-size:12px; border:1px solid currentColor; padding:3px 10px; border-radius:6px; opacity:0.8;">Local Memory</span>
                    </div>
                </div>
                <div class="card-foot">
                    <a href="tools/video-speed" class="pill pill-orange">
                        Launch Video Speed Tool <span class="ar">→</span>
                    </a>
                </div>
            </div>

            <!-- Tool 2 -->
            <div class="card c2">
                <div>
                    <span class="k">HTML5 Canvas Graphics</span>
                    <h4>Photo Collage Studio</h4>
                    <p>
                        Merge two photos side-by-side or stacked without padding or cropping. Tweak outer borders, gap spacing, and corner radius, then download the resulting high-res PNG in one click.
                    </p>
                    <div style="display:flex; flex-wrap:wrap; gap:8px; margin-top:24px;">
                        <span style="font-family:var(--mono); font-size:12px; border:1px solid currentColor; padding:3px 10px; border-radius:6px; opacity:0.8;">Side-by-Side</span>
                        <span style="font-family:var(--mono); font-size:12px; border:1px solid currentColor; padding:3px 10px; border-radius:6px; opacity:0.8;">Stacked</span>
                        <span style="font-family:var(--mono); font-size:12px; border:1px solid currentColor; padding:3px 10px; border-radius:6px; opacity:0.8;">Client-Side PNG Export</span>
                    </div>
                </div>
                <div class="card-foot">
                    <a href="tools/collage" class="pill pill-navy">
                        Launch Photo Collage Studio <span class="ar">→</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
